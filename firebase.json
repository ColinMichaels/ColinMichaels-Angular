{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs20",
    "predeploy": [
      "npm run prepare:functions-seo",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  },
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "ui": {
      "host": "127.0.0.1",
      "port": 4000
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist/colin-michaels-firebase/browser",
    "predeploy": [
      "npm run build",
      "npm run prepare:functions-seo"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemapXml",
          "region": "us-east1"
        }
      },
      {
        "source": "**",
        "function": {
          "functionId": "renderSeoHtml",
          "region": "us-east1"
        }
      }
    ]
  }
}
