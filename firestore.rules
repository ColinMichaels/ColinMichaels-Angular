rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn()
        && (
          request.auth.token[role] == true
          || request.auth.token.roles[role] == true
        );
    }

    function canAccessAdminConsole() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor')
        || hasRole('mediaManager')
        || hasRole('viewer');
    }

    function canManageCmsContent() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor');
    }

    function canManageMediaLibrary() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('mediaManager');
    }

    function canManageUserAccounts() {
      return hasRole('admin');
    }

    function isPublishedPost() {
      return resource.data.status == 'published';
    }

    function isActiveDraftPreview() {
      return resource.data.post.status == 'draft'
        && resource.data.expiresAtTimestamp is timestamp
        && resource.data.expiresAtTimestamp > request.time;
    }

    match /posts/{postId} {
      allow get, list: if canManageCmsContent() || isPublishedPost();
      allow create, update, delete: if canManageCmsContent();
    }

    match /postPreviews/{previewId} {
      allow get: if canManageCmsContent() || isActiveDraftPreview();
      allow list: if canManageCmsContent();
      allow create, update, delete: if canManageCmsContent();
    }

    match /postDrafts/{draftId} {
      allow read, write: if canManageCmsContent();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /mediaLibraryItems/{mediaId} {
      allow read: if canManageCmsContent() || canManageMediaLibrary();
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /mediaLibraryFolders/{folderId} {
      allow read: if canManageCmsContent() || canManageMediaLibrary();
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if canManageCmsContent();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if canManageCmsContent();
    }

    match /users/{userId} {
      allow read, update: if canManageUserAccounts() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if canManageUserAccounts();
    }

    match /logs/{logId} {
      allow read, write: if canManageUserAccounts();
    }

    match /{document=**} {
      allow read, write: if canManageUserAccounts();
    }
  }
}
