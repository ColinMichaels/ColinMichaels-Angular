rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn()
        && (
          request.auth.token[role] == true
          || request.auth.token.roles[role] == true
        );
    }

    function canAccessAdminConsole() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor')
        || hasRole('mediaManager')
        || hasRole('viewer');
    }

    function canManageCmsContent() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor');
    }

    function canManageMediaLibrary() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('mediaManager');
    }

    function canManageUserAccounts() {
      return hasRole('admin');
    }

    function isBackendOnlyPath(documentPath) {
      return documentPath.matches('socialConnectionSecrets/.*')
        || documentPath.matches('socialOAuthStates/.*')
        || documentPath.matches('postPolls/.*');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasZeroPoints(points) {
      return points is map
        && points.keys().hasOnly(['total', 'postReads', 'shares', 'approvedComments'])
        && points.total == 0
        && points.postReads == 0
        && points.shares == 0
        && points.approvedComments == 0;
    }

    function hasValidCommunicationPreferences(preferences) {
      return preferences is map
        && preferences.keys().hasOnly([
          'newPostEmails',
          'newsletter',
          'source',
          'updatedAt'
        ])
        && preferences.newPostEmails is bool
        && preferences.newsletter is bool
        && (
          preferences.source == 'signup-campaign'
          || preferences.source == 'profile'
        )
        && preferences.updatedAt is string;
    }

    function isApprovedComment() {
      return resource.data.status == 'approved';
    }

    function isPublishedPost() {
      return resource.data.status == 'published';
    }

    function isPublishedAuthor() {
      return resource.data.status == 'published';
    }

    function isPublishedTopic() {
      return resource.data.status == 'published';
    }

    function isPublishedRecommendedLink() {
      return resource.data.status == 'published';
    }

    function isPublishedHomepageSettings() {
      return resource.data.status == 'published';
    }

    function isMissingHomepageSettings(settingId) {
      return !exists(/databases/$(database)/documents/homepageSettings/$(settingId));
    }

    function isActiveDraftPreview() {
      return resource.data.post.status == 'draft'
        && resource.data.expiresAtTimestamp is timestamp
        && resource.data.expiresAtTimestamp > request.time;
    }

    match /posts/{postId} {
      allow get, list: if canManageCmsContent() || isPublishedPost();
      allow create, update, delete: if canManageCmsContent();
    }

    match /authors/{authorId} {
      allow get, list: if canManageCmsContent() || isPublishedAuthor();
      allow create, update, delete: if canManageCmsContent();
    }

    match /postPreviews/{previewId} {
      allow get: if canManageCmsContent() || isActiveDraftPreview();
      allow list: if canManageCmsContent();
      allow create, update, delete: if canManageCmsContent();
    }

    match /postDrafts/{draftId} {
      allow read, write: if canManageCmsContent();
    }

    match /socialOutbox/{deliveryId} {
      allow read: if canManageCmsContent();
      allow write: if false;
    }

    match /socialConnections/{providerId} {
      allow read: if canManageCmsContent();
      allow write: if false;
    }

    match /socialConnectionSecrets/{providerId} {
      allow read, write: if false;
    }

    match /socialOAuthStates/{stateId} {
      allow read, write: if false;
    }

    match /shareLinks/{shareId} {
      allow read, write: if false;
    }

    match /shareLandingEvents/{landingId} {
      allow read, write: if false;
    }

    match /pushSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /topics/{topicId} {
      allow get, list: if canManageCmsContent() || isPublishedTopic();
      allow create, update, delete: if canManageCmsContent();
    }

    match /recommendedLinks/{linkId} {
      allow get, list: if canManageCmsContent() || isPublishedRecommendedLink();
      allow create, update, delete: if canManageCmsContent();
    }

    match /homepageSettings/{settingId} {
      allow get: if canManageCmsContent()
        || (
          settingId == 'home'
          && (isMissingHomepageSettings(settingId) || isPublishedHomepageSettings())
        );
      allow list: if canManageCmsContent();
      allow create, update, delete: if canManageCmsContent();
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /mediaLibraryItems/{mediaId} {
      allow read: if canManageCmsContent() || canManageMediaLibrary();
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /mediaLibraryFolders/{folderId} {
      allow read: if canManageCmsContent() || canManageMediaLibrary();
      allow create, update, delete: if canManageMediaLibrary();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if canManageCmsContent();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if canManageCmsContent();
    }

    match /users/{userId} {
      allow read: if canManageUserAccounts() || isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerIds',
          'emailVerified',
          'roles',
          'commentTrustStatus',
          'points',
          'communicationPreferences',
          'createdAt',
          'updatedAt',
          'lastSeenAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 0
        && request.resource.data.commentTrustStatus == 'new'
        && hasZeroPoints(request.resource.data.points)
        && (
          !request.resource.data.keys().hasAny(['communicationPreferences'])
          || hasValidCommunicationPreferences(request.resource.data.communicationPreferences)
        );
      allow update: if canManageUserAccounts()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'photoURL',
            'communicationPreferences',
            'lastSeenAt',
            'updatedAt'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['communicationPreferences'])
            || hasValidCommunicationPreferences(request.resource.data.communicationPreferences)
          )
        );
      allow delete: if canManageUserAccounts();
    }

    match /postComments/{commentId} {
      allow read: if isApprovedComment() || canManageCmsContent() || canManageUserAccounts();
      allow create, update, delete: if false;
    }

    match /postPolls/{postId}/{document=**} {
      allow read, write: if false;
    }

    match /userPointEvents/{eventId} {
      allow read: if canManageUserAccounts() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow write: if false;
    }

    match /logs/{logId} {
      allow read, write: if canManageUserAccounts();
    }

    match /{document=**} {
      allow read, write: if canManageUserAccounts()
        && !isBackendOnlyPath(document);
    }
  }
}
