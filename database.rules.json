{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "public": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
