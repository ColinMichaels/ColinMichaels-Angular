{
  "name": "colinmichaels-motion-kit",
  "version": "1.0.0",
  "description": "Editable ColinMichaels.com intros, outros, transitions, stingers, and reusable video slates",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.3.0",
    "@types/web": "0.0.358",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "@eslint/compat": "2.1.1"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-assets.mjs",
    "build": "npm run assets:sync && remotion bundle",
    "dev": "npm run assets:sync && remotion studio",
    "lint": "eslint src && npm run typecheck",
    "render": "node scripts/render-all.mjs",
    "review": "node scripts/generate-review-sheet.mjs",
    "sfx:local": "node scripts/generate-local-sfx.mjs",
    "validate": "node scripts/validate-campaign.mjs",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit"
  },
  "sideEffects": [
    "*.css"
  ],
  "overrides": {
    "@remotion/eslint-config-flat": {
      "typescript-eslint": "8.71.2"
    }
  }
}
