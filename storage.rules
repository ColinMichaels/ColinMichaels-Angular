rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasRole(role) {
      return request.auth != null
        && (
          request.auth.token[role] == true
          || request.auth.token.roles[role] == true
        );
    }

    function canManageCmsContent() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor');
    }

    function canManageMediaLibrary() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('mediaManager');
    }

    function isValidCmsImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidMediaLibraryFile() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /cms/blog-thumbnails/{postSlug}/{fileName} {
      allow read: if true;
      allow write: if canManageCmsContent() && isValidCmsImage();
    }

    match /cms/blog-media/{postSlug}/{assetRole}/{fileName} {
      allow read: if true;
      allow write: if (canManageCmsContent() || canManageMediaLibrary()) && isValidCmsImage();
    }

    match /media-library/{allPaths=**} {
      allow read: if true;
      allow write: if canManageMediaLibrary() && isValidMediaLibraryFile();
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if hasRole('admin');
    }
  }
}
