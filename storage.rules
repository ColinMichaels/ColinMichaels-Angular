rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasRole(role) {
      return request.auth != null
        && (
          (request.auth.token.keys().hasAny([role]) && request.auth.token[role] == true)
          || (
            request.auth.token.roles is map
            && request.auth.token.roles.keys().hasAny([role])
            && request.auth.token.roles[role] == true
          )
        );
    }

    function canManageCmsContent() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('contentEditor');
    }

    function canManageMediaLibrary() {
      return hasRole('admin')
        || hasRole('cmsAdmin')
        || hasRole('mediaManager');
    }

    function isValidCmsImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidTrustedCmsImage() {
      return request.resource.size > 0
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/avif'
          || request.resource.contentType == 'image/gif'
        );
    }

    function isValidMediaLibraryFile() {
      return request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /cms/blog-thumbnails/{postSlug}/{fileName} {
      allow read: if true;
      allow write: if canManageCmsContent() && isValidCmsImage();
    }

    match /cms/blog-media-staging/{userId}/{mediaId}/{fileName} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (canManageCmsContent() || canManageMediaLibrary())
        && isValidTrustedCmsImage();
      allow update, delete: if false;
    }

    match /cms/blog-media/{postSlug}/{assetRole}/{mediaId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /cms/blog-media/{postSlug}/{assetRole}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /media-library/{allPaths=**} {
      allow read: if true;
      allow write: if canManageMediaLibrary() && isValidMediaLibraryFile();
    }

    match /{topLevel}/{allPaths=**} {
      // Specific blog-media rules remain authoritative. Without this exclusion,
      // the legacy fallback would re-open private staging reads and admin writes.
      // All CMS paths have explicit rules, so the generic fallback excludes them.
      allow read: if request.auth != null
        && topLevel != 'cms';
      allow write: if hasRole('admin')
        && topLevel != 'cms';
    }
  }
}
