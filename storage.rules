rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.token.cmsAdmin == true
          || request.auth.token.roles.admin == true
        );
    }

    function isValidCmsImage() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /cms/blog-thumbnails/{postSlug}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidCmsImage();
    }

    match /cms/blog-media/{postSlug}/{assetRole}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidCmsImage();
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
