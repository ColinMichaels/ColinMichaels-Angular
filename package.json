{
  "name": "colin-michaels-firebase",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration local",
    "start:live": "ng serve --configuration live-local",
    "generate:env": "node scripts/generate-environment.mjs",
    "prepare:functions-seo": "node scripts/prepare-functions-seo.mjs",
    "test:seo-shell": "node scripts/validate-seo-shell.mjs",
    "test:content-packages": "node scripts/validate-content-package-evidence.mjs",
    "test:content-runway": "node scripts/validate-content-release-runway.mjs",
    "test:docs": "node scripts/validate-documentation.mjs",
    "test:temu-preflight": "node scripts/validate-temu-production-preflight.mjs",
    "test:ace-pro-preflight": "node scripts/validate-ace-pro-production-preflight.mjs",
    "test:foundation-release": "node scripts/validate-seo-foundation-release.mjs",
    "pretest:release": "node scripts/verify-supported-node.mjs",
    "test:release": "npm run lint && npm run build && npm run test:service-worker-cache && npm run test:docs && npm test -- --watch=false && npm run test:content-packages && npm --prefix functions run test:all",
    "verify:temu-production": "node scripts/verify-temu-production-live.mjs",
    "verify:ace-pro-production": "node scripts/verify-ace-pro-production-live.mjs",
    "test:outreach-prospects": "node scripts/validate-outreach-prospects.mjs",
    "build": "ng build",
    "build:functions": "npm --prefix functions run build",
    "build:prod": "ng build --configuration production",
    "build:css": "npx tailwindcss -o ./dist/output.css --minify",
    "test:service-worker-cache": "node scripts/validate-service-worker-cache.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules:phase7": "firebase emulators:exec --only firestore,storage \"node --test test/rules/phase7.rules.test.mjs\"",
    "test:functions:phase7:emulator": "npm run build:functions && firebase emulators:exec --only firestore \"node --test functions/test/blog-publishing-emulator.test.cjs functions/test/post-summary-migration-emulator.test.cjs\"",
    "test:media:phase7:emulator": "npm run build:functions && firebase emulators:exec --only firestore,storage \"node --test functions/test/blog-media-emulator.test.cjs\"",
    "lint": "ng lint",
    "serve:functions": "npm run build:functions && firebase emulators:start --only functions",
    "serve:daily-discovery:local": "npm run build:functions && firebase emulators:start --only auth,functions,firestore",
    "seed:daily-discovery:local": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=colinmichaels node functions/scripts/seed-daily-discovery-emulator.mjs",
    "import:daily-discovery": "npm run build:functions && node functions/scripts/import-daily-discovery-questions.mjs",
    "import:daily-discovery:local": "npm run build:functions && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=colinmichaels node functions/scripts/import-daily-discovery-questions.mjs",
    "serve:emulators": "npm run build:functions && firebase emulators:start --only auth,functions,firestore,database,storage"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.30.0"
    },
    "vite": {
      "esbuild": "0.28.1"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/platform-browser-dynamic": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/service-worker": "22.0.7",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/embed": "^2.7.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@mohayonao/wave-tables": "^0.2.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.4.9",
    "dayjs": "^1.11.13",
    "firebase": "^12.14.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "ng2-charts": "^10.0.0",
    "ngx-markdown": "^22.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/core": "^22.0.7",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@faker-js/faker": "^9.7.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
