{
  "name": "colin-michaels-firebase",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration local",
    "start:live": "ng serve --configuration live-local",
    "generate:env": "node scripts/generate-environment.mjs",
    "prepare:functions-seo": "node scripts/prepare-functions-seo.mjs",
    "build": "ng build",
    "build:functions": "npm --prefix functions run build",
    "build:prod": "ng build --configuration production",
    "build:css": "npx tailwindcss -o ./dist/output.css --minify",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "serve:functions": "npm run build:functions && firebase emulators:start --only functions",
    "serve:emulators": "npm run build:functions && firebase emulators:start --only functions,firestore,database,storage"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/embed": "^2.7.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "chart.js": "^4.4.9",
    "dayjs": "^1.11.13",
    "editorjs-youtube-embed": "^1.0.3",
    "firebase": "^12.14.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "ng2-charts": "^10.0.0",
    "ngx-markdown": "^22.0.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "soundfont-player": "^0.12.0",
    "tone": "^15.1.22",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0",
    "web-audio-oscillators": "^2.0.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.1",
    "@eslint/css": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "@faker-js/faker": "^9.7.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
